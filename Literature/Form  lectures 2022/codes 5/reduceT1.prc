id  num(x?)*den(x?) = 1;
id  num(x?) = rat(x,1);
id  den(x?) = rat(1,x);
*id num(x?number_) = x;
*id den(x?number_) = 1/x;
$loopaction = 1;
label looplabel2;
ModuleOption Maximum,$loopaction;
.sort:reduceT1-loop `$numloop';
#if ( `$loopaction' == 1 )
    #redefine inumloop "0"
#endif
#enddo
*
#endprocedure
