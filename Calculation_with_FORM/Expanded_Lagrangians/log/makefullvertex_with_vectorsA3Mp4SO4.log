    * makes the full vertices in terms of the phi fields
    *Daniil: this code gets rid of traces from the Lagrangian
    #include symbols.hf
    * symbols etc needed for the SU(4)/SO(4) and SU(4)/Sp(4) case
    #define MAXINDEX "20"
    s dim;
    dimension dim;
    s sqrt2,aa,aa1,...,aa10;
    index mu,nu,al,be,ro;
    set lorentz:mu,nu,al,be,ro;
    cfunction tr;
    cfunction M,Chi,a,sext,M1,...,M10;
    set matrixfields:M,Chi,a,sext;
    cfunction phi,phiV,phiA,phiS,phiP;
    set phiset:phi,phiV,phiA,phiS,phiP;
    
    index <f1=4>,...,<f`MAXINDEX'=4>;
    set quarkindex:f1,...,f`MAXINDEX';
    symbol, <b1>,...,<b`MAXINDEX'>;
    set flavour:<b1>,...,<b`MAXINDEX'>;
    symbol i1,...,i15;
    
    s F,B0,muu,mdd,mp2,mk2,me2;
    symbol eps,epsb,epsb2,epsb1,lambda2,lambda1,log4pi,
        pi,pi16,pi162;
    cfunction delt,deltm,prop;
    vector qext,q1ext,q2ext,q3ext,q4ext,q5ext,p1ext,p2ext,p3ext,p4ext;
    vector aext1,aext2,vext1,vext2,vext3;
    vector PP,QQ,RR,SS;
    vector PPM,QQM,RRM,SSM;* (only used in procedure so beware)
    vector p0,...,p8;
    set pp:p0,...,p8;
    vector q0,...,q8;
    set qq:q0,...,q8;
    vector r0,...,r8;
    set rr:r0,...,r8;
    vector v0,v1,v2,v3;
    set vvv:v0,v1,v2,v3;
    vector w0,w1,w2,w3;
    set www:w0,w1,w2,w3;
    vector a0,a1,a2,a3;
    set aaa:a0,a1,a2,a3;
    
    symbol KK1,...,KK115;
    symbol L0,L1,L2,L3,L4,L5,L6,L7,L8,L9,L10,H1,H2;
    set Li:L0,L1,L2,L3,L4,L5,L6,L7,L8,L9,L10,H1,H2;
    vector QQP,QRS,QRS1,QRS2,QRS3;* dummy vectors, use only in procedures
    cfunction A,B,B1,B21,B22,B31,B32,C,C12,C22,C24,H,HH1,H21,H22,H23,H24,VV;
    set INTEGRALS:A,B,B1,B21,B22,B31,B32,C,C12,C22,C24,H,HH1,H21,H22,H23,H24,VV;
    #define MAXTRACE "10"
    
    * we comment this on if use the bash file
    
    * choose your vertex
    * SP4 or SO4
    
    *we comment this out if use the bash file
    
    *choose e.g. for Sp4
    *#define SX4 "SP4" 
    
    * type of vertex, choose e.g. 2Mp2
    *#define VERTEX "A3Mp2" 
    
    
    *Global expression for the terms in the Lagrangian. *Here we call the procedure 
    file; 
    *These procedures do not have any arguments
    
    #include Lagrangians_with_vectors/vertex`VERTEX'.prc
    #procedure vertexA3Mp4
    (
          + L9*sqrt2^-1*F^-3 * (
              - 4*tr(M,a(mu,nu),M(mu),M(nu))
              + 4*tr(M,a(nu,mu),M(mu),M(nu))
              + 4*tr(M,M(mu),M(nu),a(mu,nu))
              - 4*tr(M,M(mu),M(nu),a(nu,mu))
              )
    
           + L5*sqrt2^-1*F^-3 * (
              + 8/3*tr(Chi,a(mu),M(mu),M,M)
              - 4/3*tr(Chi,a(mu),M,M(mu),M)
              + 8/3*tr(Chi,a(mu),M,M,M(mu))
              + 4*tr(Chi,M(mu),a(mu),M,M)
              - 4*tr(Chi,M(mu),M,a(mu),M)
              + 8/3*tr(Chi,M(mu),M,M,a(mu))
              + 4*tr(Chi,M,a(mu),M(mu),M)
              - 4*tr(Chi,M,a(mu),M,M(mu))
              + 4*tr(Chi,M,M(mu),a(mu),M)
              - 4/3*tr(Chi,M,M(mu),M,a(mu))
              + 4*tr(Chi,M,M,a(mu),M(mu))
              + 8/3*tr(Chi,M,M,M(mu),a(mu))
              )
    
           + L4*sqrt2^-1*F^-3 * (
              + 16*tr(Chi,M,M)*tr(a(mu),M(mu))
              - 32/3*tr(M,a(mu),M,M(mu))*tr(Chi)
              + 16/3*tr(M,M,a(mu),M(mu))*tr(Chi)
              + 16/3*tr(M,M,M(mu),a(mu))*tr(Chi)
              )
    
           + L3*sqrt2^-1*F^-3 * (
              - 8*tr(a(mu),M(mu),M(nu),M(nu))
              - 8*tr(a(mu),M(nu),M(nu),M(mu))
              - 8*tr(a(nu),M(mu),M(mu),M(nu))
              - 8*tr(a(nu),M(nu),M(mu),M(mu))
              )
    
           + L2*sqrt2^-1*F^-3 * (
              - 16*tr(a(mu),M(nu))*tr(M(mu),M(nu))
              - 16*tr(a(nu),M(mu))*tr(M(mu),M(nu))
              )
    
           + L1*sqrt2^-1*F^-3 * (
              - 16*tr(a(mu),M(mu))*tr(M(nu),M(nu))
              - 16*tr(a(nu),M(nu))*tr(M(mu),M(mu))
              )
    
           + L0*sqrt2^-1*F^-3 * (
              - 16*tr(a(mu),M(nu),M(mu),M(nu))
              - 16*tr(a(nu),M(mu),M(nu),M(mu))
              )
    )
    #endprocedure
    G vertex`VERTEX'`SX4' = 
    #call vertex`VERTEX'
     ;
    
    *counting the number of elements in a trace
    *in symbols.hf we have (a set matrixfields which has Chi and so on ) ;
    id tr(?a)= tr(0,aa,?a);
    repeat;
      id tr(aa1?,?a,aa,M?matrixfields(?b),?c) = tr(aa1+1,?a,M(?b),aa,?c);
      id tr(?a,aa) = tr(?a);
    endrepeat;
    .sort

