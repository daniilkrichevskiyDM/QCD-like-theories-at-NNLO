#procedure vertex2Mp4()
(
      + L8*F^-2 * (
          - 4*tr(Chi,Chi,M,M)
          - 4*tr(Chi,M,Chi,M)
          )

       + L7*F^-2 * (
          - 8*tr(Chi,M)^2
          )

       + L6*F^-2 * (
          - 8*tr(Chi)*tr(Chi,M,M)
          )

       + L5*F^-2 * (
          + 4*tr(Chi,M(mu),M(mu))
          )

       + L4*F^-2 * (
          + 4*tr(Chi)*tr(M(mu),M(mu))
          )
)
#endprocedure
