*all momenta in the terms are outgoing

repeat;
* just takes derivative 
  id phi?{phi,phiP,phiS}(mu?lorentz,?a,p1?)= i_*p1(mu)*phi(?a,p1);
* it can happen that p1(mu)phi(mu,p3) is rewritten as phi(p1,p3). then we want to restore the normal form
  id phi?{phi,phiP,phiS}(p3?,?a,p1?)= i_*p1.p3*phi(?a,p1);
endrepeat;

*this is for vectors;
#do ii={V|A}
repeat;
  id phi`ii'(mu?lorentz,?a,nu?lorentz,b1?,v1?,p1?)=
                                    i_*p1(mu)*phi`ii'(?a,nu,b1,v1,p1);
  id phi`ii'(p2?,?a,nu?lorentz,b1?,v1?,p1?)=
                                     i_*p1.p2*phi`ii'(?a,nu,b1,v1,p1);
  id phi`ii'(mu?lorentz,?a,p3?,b1?,v1?,p1?)= 
                                     i_*p1(mu)*phi`ii'(?a,p3,b1,v1,p1);
  id phi`ii'(p2?,?a,p3?,b1?,v1?,p1?)= i_*p1.p2*phi`ii'(?a,p3,b1,v1,p1);
endrepeat;
id phi`ii'(mu?lorentz,b1?,v1?,p1?) = v1(mu)*phi`ii'(b1,v1,p1);
id phi`ii'(p2?,b1?,v1?,p1?) = v1.p2*phi`ii'(b1,v1,p1);
#enddo

