          + 2/9*HH1(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext*mp2
          - 2/9*HH1(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext*mdd
          - 2/9*HH1(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext*muu
          + 2/9*HH1(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext^2
          + 2/9*HH1(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext*mp2
          - 2/9*HH1(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext*mdd
          - 2/9*HH1(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext*muu
          + 2/9*HH1(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext^2
          + 1/9*HH1(mp2,mdd,mdd,p1ext.p1ext)*p1ext.p1ext*mp2
          + 1/18*HH1(mp2,mdd,mdd,p1ext.p1ext)*p1ext.p1ext*mdd
          + 1/18*HH1(mp2,mdd,mdd,p1ext.p1ext)*p1ext.p1ext*muu
          - 2/9*HH1(mp2,mdd,mdd,p1ext.p1ext)*p1ext.p1ext^2
          + 2/9*HH1(mp2,mp2,muu,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2*mp2
          + 4/9*HH1(mp2,mp2,muu,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          + 2/9*HH1(mp2,mp2,mdd,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2*mp2
          + 4/9*HH1(mp2,mp2,mdd,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          - 1/2*H21(muu,muu,mp2,p1ext.p1ext)*p1ext.p1ext^2
          - 1/2*H21(muu,mp2,muu,p1ext.p1ext)*p1ext.p1ext^2
          - 1/2*H21(mdd,mdd,mp2,p1ext.p1ext)*p1ext.p1ext^2
          - 1/2*H21(mdd,mp2,mdd,p1ext.p1ext)*p1ext.p1ext^2
          - 1/2*H21(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext^2
          - H21(mp2,muu,mp2,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          - 1/2*H21(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext^2
          - H21(mp2,mdd,mp2,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          - H21(mp2,mp2,muu,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          - H21(mp2,mp2,mdd,p1ext.p1ext)*p1ext.p1ext^2*sqrt2^-2
          - H21(mp2,mp2,mp2,p1ext.p1ext)*p1ext.p1ext^2
          - 1/2*H22(muu,muu,mp2,p1ext.p1ext)*p1ext.p1ext
          - 1/2*H22(muu,mp2,muu,p1ext.p1ext)*p1ext.p1ext
          - 1/2*H22(mdd,mdd,mp2,p1ext.p1ext)*p1ext.p1ext
          - 1/2*H22(mdd,mp2,mdd,p1ext.p1ext)*p1ext.p1ext
          - 1/2*H22(mp2,muu,mdd,p1ext.p1ext)*p1ext.p1ext
          - H22(mp2,muu,mp2,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2
          - 1/2*H22(mp2,mdd,muu,p1ext.p1ext)*p1ext.p1ext
          - H22(mp2,mdd,mp2,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2
          - H22(mp2,mp2,muu,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2
          - H22(mp2,mp2,mdd,p1ext.p1ext)*p1ext.p1ext*sqrt2^-2
          - H22(mp2,mp2,mp2,p1ext.p1ext)*p1ext.p1ext
          )

       + A(muu)^2*i_*F^-4 * (
          - 1/36*mp2
          - 1/36*mdd
          - 1/12*muu
          + 1/12*p1ext.p1ext
          )

       + A(muu)*A(mdd)*i_*F^-4 * (
          - 1/9*mp2
          + 1/9*mdd
          + 1/9*muu
          + 1/3*p1ext.p1ext
          )

       + A(muu)*A(mp2)*i_*F^-4 * (
          - 1/9*sqrt2^-2*mp2
          - 5/18*sqrt2^-2*muu
          - 1/18*mdd
          - 1/9*muu
          + 1/2*p1ext.p1ext
          + 5/6*p1ext.p1ext*sqrt2^-2
          )

       + A(mdd)^2*i_*F^-4 * (
          - 1/36*mp2
          - 1/12*mdd
          - 1/36*muu
          + 1/12*p1ext.p1ext
          )

       + A(mdd)*A(mp2)*i_*F^-4 * (
          - 1/9*sqrt2^-2*mp2
          - 5/18*sqrt2^-2*mdd
          - 1/9*mdd
          - 1/18*muu
          + 1/2*p1ext.p1ext
          + 5/6*p1ext.p1ext*sqrt2^-2
          )

       + A(mp2)^2*i_*F^-4 * (
          + 1/18*sqrt2^-2*mdd
          + 1/18*sqrt2^-2*muu
          - 1/6*mp2
          + 1/2*p1ext.p1ext
          + 1/3*p1ext.p1ext*sqrt2^-2
          );

