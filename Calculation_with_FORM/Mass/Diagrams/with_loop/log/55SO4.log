    #call setmom(p,4)
    .sort 
    
    
    #include takederiv.hf
    *all momenta in the terms are outgoing
    
    repeat;
    * just takes derivative 
      id phi?{phi,phiP,phiS}(mu?lorentz,?a,p1?)= i_*p1(mu)*phi(?a,p1);
