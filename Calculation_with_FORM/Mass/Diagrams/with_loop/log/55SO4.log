      id phi`ii'(p2?,?a,p3?,b1?,v1?,p1?)= i_*p1.p2*phi`ii'(?a,p3,b1,v1,p1);
    endrepeat;
    id phi`ii'(mu?lorentz,b1?,v1?,p1?) = v1(mu)*phi`ii'(b1,v1,p1);
    id phi`ii'(p2?,b1?,v1?,p1?) = v1.p2*phi`ii'(b1,v1,p1);
