
   MM3x11SO4 =

       + A(muu)*i_*F^-2 * (
          - 1/12*mdd*SymmetryFactorMass3
          - 1/12*muu*SymmetryFactorMass3
          + 1/6*p1ext.p1ext*SymmetryFactorMass3
          )

       + A(mdd)*i_*F^-2 * (
          - 1/12*mdd*SymmetryFactorMass3
          - 1/12*muu*SymmetryFactorMass3
          + 1/6*p1ext.p1ext*SymmetryFactorMass3
          )

       + A(mp2)*i_*F^-2 * (
          + 1/3*mp2*SymmetryFactorMass3
          - 11/24*mdd*SymmetryFactorMass3
          - 11/24*muu*SymmetryFactorMass3
          + 1/3*p1ext.p1ext*SymmetryFactorMass3
          );

