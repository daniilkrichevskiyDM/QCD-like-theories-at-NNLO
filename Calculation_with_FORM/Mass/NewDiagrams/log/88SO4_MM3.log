
   MM3x88SO4 =

       + A(mdd)*i_*F^-2 * (
          - 1/3*mdd*SymmetryFactorMass3
          + 1/3*p1ext.p1ext*SymmetryFactorMass3
          )

       + A(mp2)*i_*F^-2 * (
          + 1/3*mp2*SymmetryFactorMass3
          - 3/4*mdd*SymmetryFactorMass3
          - 1/6*muu*SymmetryFactorMass3
          + 1/3*p1ext.p1ext*SymmetryFactorMass3
          );

