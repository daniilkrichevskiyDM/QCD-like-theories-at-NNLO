
   MM3x33SO4 =

       + A(muu)*i_*F^-2 * (
          - 1/2*muu*SymmetryFactorMass3
          )

       + A(mdd)*i_*F^-2 * (
          - 1/2*mdd*SymmetryFactorMass3
          )

       + A(mp2)*i_*F^-2 * (
          + 2/3*mp2*SymmetryFactorMass3
          - 7/24*mdd*SymmetryFactorMass3
          - 7/24*muu*SymmetryFactorMass3
          + 2/3*p1ext.p1ext*SymmetryFactorMass3
          );

