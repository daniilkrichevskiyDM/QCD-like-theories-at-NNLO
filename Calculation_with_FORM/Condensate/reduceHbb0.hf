id Hbb(m2?,m2?,m2?,m2?) =

       + pi16 * ( 5/2*Ab(m2) )

       + pi16^2 * ( 15/8*m2 + 1/4*pi^2*m2 )

       + 3*Ab(m2)^2*m2^-1;

id H1bb(m2?,m2?,m2?,m2?) =

       + pi16 * ( 5/6*Ab(m2) )

       + pi16^2 * ( 5/8*m2 + 1/12*pi^2*m2 )

       + Ab(m2)^2*m2^-1;

id H21bb(m2?,m2?,m2?,m2?) =

       + pi16 * ( 11/36*Ab(m2) )

       + pi16^2 * ( 493/864*m2 + 1/18*pi^2*m2 )

       + 2/3*Ab(m2)^2*m2^-1;

id Hdd(m2?,m2?,m2?,m2?) =

       + pi16 * (  - 1/2*Ab(m2)*m2^-1 )

       + pi16^2 * ( 7/8 );

id H1dd(m2?,m2?,m2?,m2?) =

       + pi16 * (  - 1/6*Ab(m2)*m2^-1 )

       + pi16^2 * ( 7/24 );

id H21dd(m2?,m2?,m2?,m2?) =

       + pi16 * (  - 1/12*Ab(m2)*m2^-1 )

       + pi16^2 * ( 43/288 );
