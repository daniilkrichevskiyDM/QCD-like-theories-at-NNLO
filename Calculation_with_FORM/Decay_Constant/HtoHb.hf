
* log4pi = log(4pi)-gamma+1
* dim = 4-2*eps
* 1/epsb = 1/eps+log4pi, i.e. it is lambda0

repeat;
id H22(m1?,m2?,m3?,m4?) =
 1/dim*(m1*H(m1,m2,m3,m4)+A(m2)*A(m3)
         -m4*H21(m1,m2,m3,m4));

id   H(m1?,m2?,m3?,m4?) =
       + Hbb(m1,m2,m3,m4)
       + log4pi^2*pi16^2 * ( 1/2*m1 + 1/2*m2 + 1/2*m3 )

       + log4pi*pi16^2 * ( 1/2*m1 + 1/2*m2 + 1/2*m3 )

       + log4pi*pi16 * ( Ab(m1) + Ab(m2) + Ab(m3) )

       + epsb^-1*pi16^2 * ( 1/2*m1 + 1/2*m2 + 1/2*m3 )

       + epsb^-1*pi16 * ( Ab(m1) + Ab(m2) + Ab(m3) )

       + epsb^-2*pi16^2 * ( 1/2*m1 + 1/2*m2 + 1/2*m3 )

       + m4*log4pi*pi16^2 * (  - 1/4 )

       + m4*epsb^-1*pi16^2 * (  - 1/4 );

id   HH1(m1?,m2?,m3?,m4?) =
       + H1bb(m1,m2,m3,m4)
       + log4pi^2*pi16^2 * ( 1/4*m2 + 1/4*m3 )

       + log4pi*pi16^2 * ( 1/4*m1 + 1/8*m2 + 1/8*m3 )

       + log4pi*pi16 * ( 1/2*Ab(m2) + 1/2*Ab(m3) )

       + epsb^-1*pi16^2 * ( 1/4*m1 + 1/8*m2 + 1/8*m3 )

       + epsb^-1*pi16 * ( 1/2*Ab(m2) + 1/2*Ab(m3) )

       + epsb^-2*pi16^2 * ( 1/4*m2 + 1/4*m3 )

       + m4*log4pi*pi16^2 * (  - 1/12 )

       + m4*epsb^-1*pi16^2 * (  - 1/12 );

id   H21(m1?,m2?,m3?,m4?) =
       + H21bb(m1,m2,m3,m4)
       + log4pi^2*pi16^2 * ( 1/6*m2 + 1/6*m3 )

       + log4pi*pi16^2 * ( 1/12*m1 + 1/18*m2 + 1/18*m3 )

       + log4pi*pi16 * ( 1/3*Ab(m2) + 1/3*Ab(m3) )

       + epsb^-1*pi16^2 * ( 1/12*m1 + 1/18*m2 + 1/18*m3 )

       + epsb^-1*pi16 * ( 1/3*Ab(m2) + 1/3*Ab(m3) )

       + epsb^-2*pi16^2 * ( 1/6*m2 + 1/6*m3 )

       + m4*log4pi*pi16^2 * (  - 1/24 )

       + m4*epsb^-1*pi16^2 * (  - 1/24 );

id   Hd(m1?,m2?,m3?,m4?) =
       + Hdd(m1,m2,m3,m4)

       + log4pi*pi16^2 * (  - 1/4 )

       + epsb^-1*pi16^2 * (  - 1/4 );

id   H1d(m1?,m2?,m3?,m4?) =
       + H1dd(m1,m2,m3,m4)

       + log4pi*pi16^2 * (  - 1/12 )

       + epsb^-1*pi16^2 * (  - 1/12 );

id   H21d(m1?,m2?,m3?,m4?) =
       + H21dd(m1,m2,m3,m4)

       + log4pi*pi16^2 * (  - 1/24 )

       + epsb^-1*pi16^2 * (  - 1/24 );
endrepeat;

