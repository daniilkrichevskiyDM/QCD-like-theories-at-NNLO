          - 1/108*p1ext.Pol1*sqrt2^-1*muu
          )

       + H(mp2,mdd,mp2,p1ext.p1ext)*F^-3 * (
          + 4/27*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          + 1/54*p1ext.Pol1*sqrt2^-1*mp2
          )

       + H(mp2,mp2,muu,p1ext.p1ext)*F^-3 * (
          - 2/27*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          - 1/27*p1ext.Pol1*sqrt2^-1*mp2
          )

       + H(mp2,mp2,mdd,p1ext.p1ext)*F^-3 * (
          - 2/27*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          - 1/27*p1ext.Pol1*sqrt2^-1*mp2
          )

       + H(mp2,mp2,mp2,p1ext.p1ext)*F^-3 * (
          + 2/9*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          );

