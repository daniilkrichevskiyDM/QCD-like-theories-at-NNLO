          - 8/27*p1ext.Pol1*sqrt2^-1*mp2
          + 4/9*p1ext.Pol1*sqrt2^-1*muu
          )

       + H(mp2,mp2,mdd,p1ext.p1ext)*F^-3 * (
          + 20/27*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          - 8/27*p1ext.Pol1*sqrt2^-1*mp2
          + 4/9*p1ext.Pol1*sqrt2^-1*mdd
          )

       + H(mp2,mp2,mp2,p1ext.p1ext)*F^-3 * (
          + 4/9*p1ext.p1ext*p1ext.Pol1*sqrt2^-1
          );

